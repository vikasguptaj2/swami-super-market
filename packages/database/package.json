{
  "name": "@swami/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:init": "tsx src/init-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "tsx src/init-db.ts && drizzle-kit push",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@swami/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
